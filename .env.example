# ====================================================
# MediVault Environment Variables Configuration
# ====================================================

# Django Core
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database
DATABASE_URL=postgres://medivault_user:medivault_secret@localhost:5432/medivault_db
DB_NAME=medivault_db
DB_USER=medivault_user
DB_PASSWORD=medivault_secret
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Google Cloud Vision (OCR)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=medivault-vision-ocr

# OpenAI API (LLM & Embeddings)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=medivault_patient_documents

# JWT Security
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Messaging & Notification Gateway
# Options: 'email' (Recommended for development/prototype to avoid SMS costs) | 'sms' (Production)
MESSAGING_BACKEND=email

# SMTP Email Configuration (Used for OTP, Queue Serials & Alerts in Dev/Prototype)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=MediVault <no-reply@medivault.app>

# Bangladesh SMS Gateway (e.g. BulkSMSBD / SSL Wireless - For Production)
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=MediVault

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

