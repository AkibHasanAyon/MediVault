# ====================================================
# MediVault Production Environment Variables Template
# Copy to .env.prod on your production VPS
# ====================================================

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-high-entropy-64-char-random-string
DJANGO_ALLOWED_HOSTS=medivault.app,api.medivault.app,localhost

# PostgreSQL 16
POSTGRES_DB=medivault_prod
POSTGRES_USER=medivault_admin
POSTGRES_PASSWORD=use-a-strong-random-database-password-here

# Redis 7
REDIS_PASSWORD=use-a-strong-random-redis-password-here

# AI & Cloud Services
OPENAI_API_KEY=sk-proj-your-production-openai-key-here
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# Email / Notifications
MESSAGING_BACKEND=email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-production-alert-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password

